meta {
  name: Add Tenant 2 Config
  type: http
  seq: 4
}

post {
  url: http://{{LOCALDEVURL}}/api/v1/tenants/tenant2/UiConfig
  body: json
  auth: none
}

headers {
  uId: localDev
  tenantId: tenant1
}

body:json {
  {
    "configId": "Id",
    "configName": "TEST",
    "googleFont": "AFont",
    "appBannerUrl": "https://storage.googleapis.com/tenant1_assets/Bannar2.png",
    "appTitle": "Technology Two",
    "homeTitle": "Homey",
    "peopleTitle": "Peopley",
    "calendarTitle": "Calendary",
    "tribesTitle": "Tribesy",
    "moreTitle": "Othery",
    "titleFontSize": "30px",
    "headingFontSize": "30px",
    "textFontSize": "30px",
    "subTextFontSize": "30px",
    "smallSpacing": "8px",
    "mediumSpacing": "16px",
    "largeSpacing": "32px",
    "primaryColor": "green",
    "secondaryColor":"green",
    "tertiaryColor": "green",
    "backgroundColor": "green",
    "textColor": "green",
    "inputsColor": "green"
  }
}

tests {
  test("Status code is 200 (Added)", function () {
      expect(res.getStatus()).to.equal(200);
