meta {
  name: Add Config
  type: http
  seq: 1
}

post {
  url: http://{{LOCALDEVURL}}/UiConfig/tenant1
  body: json
  auth: none
}

headers {
  uId: localDev
  tenantId: tenant1
}

body:json {
