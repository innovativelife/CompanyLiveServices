meta {
  name: DevMode with uId not in header
  type: http
  seq: 2
}

get {
  url: http://{{LOCALDEVURL}}/Employees/tenant1
  body: none
  auth: bearer
}

headers {
  tenantId: aValue
}

auth:bearer {
  token: {{AuthToken}}
}

tests {
  test("Status code is 401 (Ok)", function () {
      expect(res.getStatus()).to.equal(401);
  });
}
