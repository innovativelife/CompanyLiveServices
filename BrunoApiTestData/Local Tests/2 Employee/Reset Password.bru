meta {
  name: Reset Password
  type: http
  seq: 8
}

put {
  url: http://{{LOCALDEVURL}}/Employees/tenant1/{{employeeUID}}/resetpassword/newpassword
  body: json
  auth: bearer
}

headers {
  uId: tester
  tenantId: tenant1
}

auth:bearer {
  token: {{AuthToken}}
}

tests {
  test("Status code is 200 (Ok)", function () {
      expect(res.getStatus()).to.equal(200);
  });
}
