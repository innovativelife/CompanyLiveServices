meta {
  name: Read Employees by UID
  type: http
  seq: 23
}

get {
  url: http://{{LOCALDEVURL}}/Employees/tenant1?employeeUID=0b333622-ff6d-490b-8a2e-20745e54e4fe
  body: json
  auth: bearer
}

params:query {
  employeeUID: 0b333622-ff6d-490b-8a2e-20745e54e4fe
}

headers {
  uId: tester
  tenantId: tenant1
}

auth:bearer {
  token: {{AuthToken}}
}

tests {
  test("Status code is 200 (Ok)", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  const jsonResponse = res.getBody();
  
  test("three employees returned", function () {
      expect(jsonResponse.employees.length).to.equal(2);
  });
  
}
