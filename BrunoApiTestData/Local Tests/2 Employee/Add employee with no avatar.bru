}

post {
  url: http://{{LOCALDEVURL}}/api/v1/tenants/tenant1/Employees
  body: json
  auth: bearer
}

headers {
  uId: localDev
  tenantId: tenant1
}

auth:bearer {
  token: {{AuthToken}}
}

body:json {
