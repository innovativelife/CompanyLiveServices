meta {
  name: Add  Employee
  type: http
  seq: 2
}

post {
  url: http://{{LOCALDEVURL}}/api/v1/tenants/tenant1/Employees
  body: json
  auth: bearer
}

headers {
  uId: localDev
  tenantId: tenant1
}

auth:bearer {
  token: {{AuthToken}}
}

body:json {
  {
      "email": "got.you.jim@gmail.com",
      "firstName": "James",
      "lastName": "Brown",
      "PreferredName": "Jim",
      "phoneNumber": "699879879",
      "initialPassword": "TEshhde",
      "employeeNumber": "12345",
      "positionTitle": "Head of stuff",
      "personalDescription": "Person in charge of lots of things",
    "avatarURL": "https://storage.googleapis.com/tenant1_assets/Person1"
  }
}

script:post-response {
  const jsonResponse = res.getBody();
  bru.setVar("got.you.jim-UID", jsonResponse.employee.employeeUID);
}

tests {
  test("Status code is 201 (Added)", function () {
      expect(res.getStatus()).to.equal(201);
  });
  
  const jsonResponse = res.getBody();
  
  bru.setVar("employeeUID", jsonResponse.employee.employeeUID)
}
