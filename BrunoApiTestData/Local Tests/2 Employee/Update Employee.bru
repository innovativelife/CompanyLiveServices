meta {
  name: Update Employee
  type: http
  seq: 9
}

put {
  url: http://{{LOCALDEVURL}}/api/v1/tenants/tenant1/Employees/{{employeeUID}}
  body: json
  auth: bearer
}

headers {
  uId: tester
  tenantId: tenant1
}

auth:bearer {
  token: {{AuthToken}}
}

body:json {
  {
      "tenantId": "tenant1",
      "email": "got.you.jim@gmail.com",
      "firstName": "James",
      "lastName": "Brown",
      "PreferredName": "Jim",
      "phoneNumber": "699879879",
      "initialPassword": "TEshhde",
      "employeeNumber": "12345",
      "positionTitle": "Head of stuff",
      "personalDescription": "Person in charge of lots of things"
  }
}

tests {
  test("Status code is 200 (Ok)", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
