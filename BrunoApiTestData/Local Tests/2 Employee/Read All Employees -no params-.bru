meta {
  name: Read All Employees -no params-
  type: http
  seq: 13
}

get {
  url: http://{{LOCALDEVURL}}/Employees/tenant1
  body: json
  auth: bearer
}

headers {
  uId: tester
  tenantId: Tenant1
}

auth:bearer {
  token: {{AuthToken}}
}

tests {
  test("Status code is 200 (Ok)", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  const jsonResponse = res.getBody();
  
  test("at least three employees returned", function () {
      expect(jsonResponse.employees.length>=3);
  });
  
}
