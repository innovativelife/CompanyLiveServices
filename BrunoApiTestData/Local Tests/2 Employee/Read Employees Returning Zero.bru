meta {
  name: Read Employees Returning Zero
  type: http
  seq: 16
}

get {
  url: http://{{LOCALDEVURL}}/api/v1/tenants/tenant1/Employees?lastName=unknown
  body: json
  auth: bearer
}

params:query {
  lastName: unknown
}

headers {
  uId: tester
  tenantId: tenant1
}

auth:bearer {
  token: {{AuthToken}}
}

tests {
  test("Status code is 404 (Ok)", function () {
      expect(res.getStatus()).to.equal(404);
  });
  
  const jsonResponse = res.getBody();
  
  test("three employees returned", function () {
      expect(jsonResponse.employees.length).to.equal(0);
  });
  
}
