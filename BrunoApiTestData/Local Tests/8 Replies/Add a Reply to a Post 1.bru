meta {
  name: Add a Reply to a Post 1
  type: http
  seq: 1
}

post {
  url: http://{{LOCALDEVURL}}/api/v1/tenants/tenant1/{{firstPostId}}/reply
  body: json
  auth: inherit
}

headers {
  uId: localDev
  tenantId: tenant1
}

body:json {
  {
    "employeeUID": "{{tenant1employeeUID}}",
    "message": "I am replying to this message"
  }
}
