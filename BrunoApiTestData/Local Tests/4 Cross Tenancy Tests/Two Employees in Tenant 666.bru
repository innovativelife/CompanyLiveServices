meta {
  name: Two Employees in Tenant 666
  type: http
  seq: 2
}

get {
  url: http://{{LOCALDEVURL}}/api/v1/Tenants/tenant666/Employees
  body: json
  auth: bearer
}

headers {
  uId: localDev
  tenantId: tenant666
}

auth:bearer {
  token: {{AuthToken}}
}

tests {
  test("Status code is 200 (Ok)", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  const jsonResponse = res.getBody();
  
  test("Only two employees found", function () {
      expect(jsonResponse.employees.length=2);
  });
  
}
