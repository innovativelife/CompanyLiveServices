tests {
  test("Status code is 422 (Error)", function () {
      expect(res.getStatus()).to.equal(422);
  });
  
  const jsonResponse = res.getBody();
  test("4 errors detected", function () {
      expect(jsonResponse.success).to.equal(false);
      expect(jsonResponse.messages.length).to.equal(4);
  });
}
