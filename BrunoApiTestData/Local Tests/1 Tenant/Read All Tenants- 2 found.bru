meta {
  name: Read All Tenants- 2 found
  type: http
  seq: 8
}

get {
  url: http://{{LOCALDEVURL}}/Tenants
  body: none
  auth: bearer
}

headers {
  tenantId: Root
  Accept-Language: en-GB
  uId: tester
}

auth:bearer {
  token: {{AuthToken}}
}

tests {
  test("Status code is 200 (Ok)", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  const jsonResponse = res.getBody();
  test("2 tenants returned", function () {
      expect(jsonResponse.tenants.length).to.equal(2);
  });
}
