meta {
  name: Update Employee Error - Cross tenant
  type: http
  seq: 3
}

put {
  url: https://{{URL}}/api/v1/Tenants/tenant999/Employees/{{Tenant999-AddedEmployeeUID}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{NewTenant-Admin1-AuthToken}}
}

body:json {
  {
      "email": "got.you.jumpier@gmail.com",
      "firstName": "Error",
      "lastName": "Brown",
      "PreferredName": "Jim",
      "phoneNumber": "+39924344666",
      "employeeNumber": "59126668",
      "leaderEmployeeNumber": "",
      "positionTitle": "BOSS",
      "personalDescription": "Boss of all things"
  }
}

tests {
  test("Status code is 401 (Unauthorized) for " + "{{Admin1-AuthToken}}", function () {
      expect(res.getStatus()).to.equal(401);
  });
  
  
}
