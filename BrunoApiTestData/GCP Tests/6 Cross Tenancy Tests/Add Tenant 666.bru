tests {
  test("Status code is 201 (created)", function () {
      expect(res.getStatus()).to.equal(201);
  });
  
  jsonResponse = res.getBody();
  
  bru.setVar("Tenant666-IdMgrTenantId", jsonResponse.tenant.identityManagerTenantId)
  
  bru.setVar("Tenant666-PrimayAdminUID", jsonResponse.tenant.primaryAdministrator.employeeUID)
  
  bru.setVar("Tenant666-SecondaryAdminUID", jsonResponse.tenant.secondaryAdministrator.employeeUID)
  
}
