meta {
  name: Save Config
  type: http
  seq: 2
}

post {
  url: https://{{URL}}/api/v1/Tenants/tenant999/UiConfig
  body: json
  auth: bearer
}

headers {
  tenantId: tenant1
}

auth:bearer {
  token: {{Admin1-AuthToken}}
}

body:json {
  {
    "configId": "Id",
    "configName": "TEST",
    "googleFont": "AFont",
    "appBannerUrl": "https://storage.googleapis.com/tenant1_assets/Bannar2.png",
    "appTitle": "Technology Two",
    "homeTitle": "Home",
    "peopleTitle": "People",
    "calendarTitle": "Calendar",
    "tribesTitle": "Tribes",
    "moreTitle": "Other",
    "titleFontSize": "18px",
    "headingFontSize": "18px",
    "textFontSize": "16px",
    "subTextFontSize": "14px",
    "smallSpacing": "8px",
    "mediumSpacing": "16px",
    "largeSpacing": "32px",
    "primaryColor": "#F2E6CE",
    "secondaryColor":"#827A69",
    "tertiaryColor": "#FCFAF7",
    "backgroundColor": "#FFFFFF",
    "textColor": "#171412",
    "inputsColor": "#F5F2F2"
  }
}

tests {
  test("Status code is 200 (Added)", function () {
      expect(res.getStatus()).to.equal(200);
  });
}
