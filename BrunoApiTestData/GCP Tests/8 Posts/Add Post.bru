meta {
  name: Add Post
  type: http
  seq: 1
}

post {
  url: https://{{URL}}/api/v1/tenants/tenant999/post
  body: json
  auth: bearer
}

headers {
  uId: localDev
  tenantId: tenant1
}

auth:bearer {
  token: {{Greg-AuthToken}}
}

body:json {
  {
    "message": "Hello, this is a message",
    "imageURL": "https://storage.googleapis.com/tenant1_assets/SamplePost",
    "employeeUID": "{{Tenant999-GregSmith}}",
    "status":"sent",
    "sendTo":"all"
  }
}

tests {
  test("Status code is 422 (Error)", function () {
      expect(res.getStatus()).to.equal(422);
  });
  
  const jsonResponse = res.getBody();
  test("55 errors detected", function () {
      expect(jsonResponse.success).to.equal(false);
      expect(jsonResponse.messages.length).to.equal(55);
  });
}
