meta {
  name: Read All Tenant - None initially
  type: http
  seq: 1
}

get {
  url: https://{{URL}}/api/v1/Admin/Tenants
  body: none
  auth: bearer
}

headers {
  Accept-Language: en-GB
}

auth:bearer {
  token: {{AuthToken}}
}

tests {
  test("Status code is 404 (not found)", function () {
      expect(res.getStatus()).to.equal(404);
  });
  
  const jsonResponse = res.getBody();
  
  test("No tenants returned)", function () {
      expect(jsonResponse.tenants) == null;
  });
  
}
