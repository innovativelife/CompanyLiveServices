meta {
  name: Read All Tenant - Now added
  type: http
  seq: 5
}

get {
  url: https://{{URL}}/api/v1/Tenants
  body: none
  auth: bearer
}

headers {
  Accept-Language: en-GB
}

auth:bearer {
  token: {{AuthToken}}
}

tests {
  test("Status code is 200 (found)", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  const jsonResponse = res.getBody();
  
  test("One tenant returned)", function () {
      expect(jsonResponse.tenants.length).to.equal(1);
  });
  
}
