meta {
  name: Get Auth Token - Greg Smith
  type: http
  seq: 15
}

post {
  url: https://www.googleapis.com/identitytoolkit/v3/relyingparty/verifyPassword?key={{AUTHKEY}}
  body: json
  auth: none
}

params:query {
  key: {{AUTHKEY}}
}

body:json {
  {
      "email": "greg@innovativelife.studio",
      "password": "ei299@9933",
      "tenantId": "{{Tenant999-IdMgrTenantId}}",
      "returnSecureToken": true
  }
}

script:post-response {
  const jsonResponse = res.getBody();
  
  bru.setVar("Greg-AuthToken", jsonResponse.idToken)
}

tests {
  test("Status code is 200 (Ok)", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  const jsonResponse = res.getBody();
  
  test("ID Token returned", function () {
      expect(jsonResponse.idToken.length).to.greaterThan(0);
  });
  
}
