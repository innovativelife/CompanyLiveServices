meta {
  name: Read All Employees - 3 returned
  type: http
  seq: 5
}

get {
  url: http://{{URL}}/api/v1/Tenants/tenant999/Employees
  body: none
  auth: bearer
}

auth:bearer {
  token: {{Admin1-AuthToken}}
}

tests {
  test("Status code is 200 (Ok) for " + "{{Admin1-AuthToken}}", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  
  const jsonResponse = res.getBody();
  
  test("Expect two employees returned)", function () {
      expect(jsonResponse.employees.length).to.equal(3);
  });
}
