meta {
  name: Add  Employee - Greg Innovate
  type: http
  seq: 12
}

post {
  url: https://{{URL}}/api/v1/Tenants/tenant999/Employees
  body: json
  auth: bearer
}

auth:bearer {
  token: {{Admin1-AuthToken}}
}

body:json {
  {
      "email": "greg@innovativelife.studio",
      "firstName": "Gregory",
      "lastName": "Innovate",
      "PreferredName": "Greg",
      "phoneNumber": "+39924344999",
      "initialPassword": "TEshhde",
      "employeeNumber": "59120999",
      "leaderEmployeeNumber": "",
      "positionTitle": "CTO",
      "personalDescription": "Chief Technical Office"
  }
}

tests {
  test("Status code is 201 (Created) for " + "{{Admin1-AuthToken}}", function () {
      expect(res.getStatus()).to.equal(201);
  });
  
  const jsonResponse = res.getBody();
  
  test("Correct tenant ID saved", function () {
      expect(jsonResponse.employee.tenantId).to.equal("tenant999");
  });
  
  test("email saved", function () {
      expect(jsonResponse.employee.email).to.equal("greg@innovativelife.studio");
  });
  
  test("phoneNumber saved", function () {
      expect(jsonResponse.employee.phoneNumber).to.equal("+39924344999");
  });
  
  test("firstName saved", function () {
      expect(jsonResponse.employee.firstName).to.equal("Gregory");
  });
  
  test("lastName saved", function () {
      expect(jsonResponse.employee.lastName).to.equal("Smith");
  });
  
  test("preferredName saved", function () {
      expect(jsonResponse.employee.preferredName).to.equal("Greg");
  });
  
  test("displayName correct", function () {
      expect(jsonResponse.employee.displayName).to.equal("Greg Brown");
  });
  
  test("employeeNumber saved", function () {
      expect(jsonResponse.employee.employeeNumber).to.equal("59120999");
  });
  
  test("positionTitle saved", function () {
      expect(jsonResponse.employee.positionTitle).to.equal("CTO");
  });
  
  test("Chief Executive Office saved", function () {
      expect(jsonResponse.employee.personalDescription).to.equal("Chief Technical Office");
  });
  
  test("active saved", function () {
      expect(jsonResponse.employee.active).to.equal(true);
  });
  
  test("adminPrivilege saved", function () {
      expect(jsonResponse.employee.adminPrivilege).to.equal(false);
  });
  
  bru.setVar("Tenant999-GregSmith", jsonResponse.employee.employeeUID)
  
}
